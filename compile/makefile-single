include cpp-baseutils/compile/makefile-base

SRCS := $(shell find $(SRC_DIR) -name '*.cpp')
OBJS := $(patsubst $(SRC_DIR)/%.cpp,$(BUILD_DIR)/%.o,$(SRCS))
DEPS := $(OBJS:.o=.d)

include cpp-baseutils/compile/makefile-obj

link: $(OBJS)
	@mkdir -p $(EXPORT_DIR)
	$(CXX) $(WIN_META_RES) $^ $(CXXFLAGS) $(LDFLAGS) $(SHARED_DEFS) -o $(TARGET)
package: package_base link
